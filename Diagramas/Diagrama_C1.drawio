        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    Customer[\&quot; Cliente B2B / B2C&lt;br&gt;[Persona]&lt;br&gt;Crea órdenes de compra/despacho y consulta tracking en tiempo real.\&quot;] -- \&quot;Crea órdenes y consulta tracking&lt;br&gt;(HTTPS / TLS 1.3)\&quot; --&gt; NexusSystem[\&quot;🏢 Plataforma NexusEngine v2.0&lt;br&gt;[Software System]&lt;br&gt;Plataforma distribuida de logística omnicanal, ruteo GPS, pagos fintech y facturación.&lt;br&gt;(120k despachos/día en 5 países)\&quot;]\n    Driver[\&quot;Transportista Última Milla&lt;br&gt;[Persona]&lt;br&gt;Recibe rutas óptimas, reporta coordenadas GPS y registra cobros COD.\&quot;] -- \&quot;Actualiza estados, GPS y pagos COD&lt;br&gt;(HTTPS / WebSockets TLS 1.3)\&quot; --&gt; NexusSystem\n    FinanceUser[\&quot; Equipo de Finanzas y Auditoría&lt;br&gt;[Persona]&lt;br&gt;Supervisa conciliaciones bancarias, facturación y reportes PCI-DSS.\&quot;] -- \&quot;Audita conciliación y facturación&lt;br&gt;(HTTPS / TLS 1.3)\&quot; --&gt; NexusSystem\n    NexusSystem -- Cotiza tarifas y delega envíos&lt;br&gt;(HTTPS / REST / SOAP) --&gt; Carriers3PL[\&quot; Operadores Logísticos Externos (3PL)&lt;br&gt;[External System]&lt;br&gt;APIs heterogéneas (REST/SOAP/GraphQL) de couriers internacionales y regionales.\&quot;]\n    NexusSystem -- \&quot;Tokeniza, procesa cobros y concilia&lt;br&gt;(HTTPS / TLS 1.3 / ISO-8583)\&quot; --&gt; PaymentGateways[\&quot; Pasarelas de Pago y Bancos&lt;br&gt;[External System]&lt;br&gt;Procesadores de tarjetas, billeteras digitales y bancos para conciliación.\&quot;]\n    NexusSystem -- Emite documentos tributarios&lt;br&gt;(HTTPS / XML / JSON) --&gt; TaxAuthority[\&quot; Entidades Tributarias (5 Países)&lt;br&gt;[External System]&lt;br&gt;SII / SUNAT / DIAN / etc. para emisión de facturación electrónica.\&quot;]\n    NexusSystem -- Despacha alertas asíncronas&lt;br&gt;(HTTPS / SMTP) --&gt; NotificationProviders[\&quot; Proveedores Email / SMS / Push&lt;br&gt;[External System]&lt;br&gt;Servicios transaccionales (AWS SES, Twilio, FCM).\&quot;]\n\n     Customer:::person\n     Driver:::person\n     FinanceUser:::person\n     NexusSystem:::system\n     Carriers3PL:::external\n     PaymentGateways:::external\n     TaxAuthority:::external\n     NotificationProviders:::external\n    classDef person fill:#08427b,stroke:#052e56,color:#ffffff\n    classDef system fill:#1168bd,stroke:#0b4884,color:#ffffff\n    classDef external fill:#999999,stroke:#6b6b6b,color:#ffffff&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="QKaY6ufUY5QWxxiP74Xu-299">
