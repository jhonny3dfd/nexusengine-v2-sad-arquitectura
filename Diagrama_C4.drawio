        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n  theme: neutral\n  themeVariables:\n    fontFamily: Arial\n    fontSize: 24px\n  flowchart:\n    nodeSpacing: 25\n    rankSpacing: 20\n    padding: 10\n---\nflowchart TB\n    Controller[\&quot;&lt;b&gt;OrderController&lt;/b&gt;&lt;br/&gt;-create_order_uc: CreateOrderUseCase&lt;br/&gt;&lt;br/&gt;+post_create_order(&lt;br/&gt;request: OrderDTO) ResponseDTO\&quot;]\n\n    UseCase[\&quot;&lt;b&gt;CreateOrderUseCase&lt;/b&gt;&lt;br/&gt;-order_repo: IOrderRepository&lt;br/&gt;-pricing_ctx: OrderPricingContext&lt;br/&gt;-carrier_creator: LogisticsCarrierCreator&lt;br/&gt;-payment_port: IPaymentGatewayPort&lt;br/&gt;&lt;br/&gt;+execute(cmd: CreateOrderCommand)&lt;br/&gt;OrderReceiptDTO\&quot;]\n\n    Order[\&quot;&lt;b&gt;Order&lt;/b&gt;&lt;br/&gt;+order_id: UUID&lt;br/&gt;+customer_id: str&lt;br/&gt;+status: OrderStatus&lt;br/&gt;+total_amount_cents: int&lt;br/&gt;+tracking_code: str&lt;br/&gt;&lt;br/&gt;+assign_waybill(code: str) void&lt;br/&gt;+mark_as_paid(tx_id: str) void&lt;br/&gt;+mark_pending_billing() void\&quot;]\n\n    Repository[\&quot;«interface»&lt;br/&gt;&lt;b&gt;IOrderRepository&lt;/b&gt;&lt;br/&gt;+save_with_outbox(&lt;br/&gt;order: Order, event: DomainEvent) void&lt;br/&gt;+find_by_id(order_id: UUID) Order\&quot;]\n\n    Postgres[\&quot;&lt;b&gt;PostgresOrderRepository&lt;/b&gt;&lt;br/&gt;-db_session: Session&lt;br/&gt;&lt;br/&gt;+save_with_outbox(&lt;br/&gt;order: Order, event: DomainEvent) void&lt;br/&gt;+find_by_id(order_id: UUID) Order\&quot;]\n\n    Pricing[\&quot;&lt;b&gt;OrderPricingContext&lt;/b&gt;&lt;br/&gt;-strategy: ITariffCalculationStrategy&lt;br/&gt;&lt;br/&gt;+execute_pricing(&lt;br/&gt;data: OrderPricingInput) float\&quot;]\n\n    Carrier[\&quot;«abstract»&lt;br/&gt;&lt;b&gt;LogisticsCarrierCreator&lt;/b&gt;&lt;br/&gt;+plan_and_dispatch(&lt;br/&gt;order_id: str, dest: str,&lt;br/&gt;weight: float) WaybillReceipt\&quot;]\n\n    Payment[\&